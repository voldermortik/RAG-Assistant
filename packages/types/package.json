{
  "name": "@flowcore/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types for FlowCore",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./workflow": {
      "types": "./src/workflow.ts",
      "import": "./dist/workflow.js"
    },
    "./execution": {
      "types": "./src/execution.ts",
      "import": "./dist/execution.js"
    },
    "./tenant": {
      "types": "./src/tenant.ts",
      "import": "./dist/tenant.js"
    },
    "./connector": {
      "types": "./src/connector.ts",
      "import": "./dist/connector.js"
    },
    "./billing": {
      "types": "./src/billing.ts",
      "import": "./dist/billing.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./dist/api.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  }
}
